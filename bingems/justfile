# justfile for bingems

# Load environment variables from .env file automatically
set dotenv-load := true

# List all available commands
list:
    @just -l

# Install dependencies
install:
    uv pip install -e .

# Run the Joplin reader
run-joplin *ARGS:
    uv run --active python src/joplin_reader.py {{ARGS}}

# Run the weather and sport forecaster
# Make sure GOOGLE_CLOUD_PROJECT is set in your environment
run-zuri-weather:
    uv run --active python src/weather_sport_forecaster.py
