set dotenv-load := true

# TODO: add APP_VERSION=`cat VERSION`

# Justfile for the portfolio application

# List all available commands
list:
    @just -l

# Run the development server
run:
    npm run dev -- -p 3001

# Install dependencies
install:
    npm install

# Run the development server and log output
run-dev:
    mkdir -p log
    npm run dev -- -p 3001 &> log/dev.log

# View the development log
log:
    cat log/dev.log

# Run tests
test:
    @echo "Running tests... Riccardo 2 gemini: note this code tends to execute for >5min so refrain from running it yourself"
    npm run lint # or maybe npx eslint . ?
    time npm test

# [JOB] Import data from YAML to SQLite
import:
    npx tsx scripts/import-yaml.ts

# [DOCKER] Build the Docker image
docker-build:
    docker build -t portfolio-app:v`cat VERSION` .

# [DOCKER] Run the Docker container
docker-run:
    mkdir -p log
    docker run -p 8080:8080 portfolio-app:v`cat VERSION` &> log/docker.log

# Print environment variables                       │
env-print:
    @echo "Project ID: ${GOOGLE_PROJECT_ID}"
    @echo "Region: ${GOOGLE_REGION}"

# Trigger a Cloud Build using the local source
build:
    @echo "Building and deploying to project ${GOOGLE_PROJECT_ID}..."
    @gcloud builds submit --project="${GOOGLE_PROJECT_ID}" --config cloudbuild.yaml .

# Trigger the Cloud Build pipeline from the git repository
trigger-build:
    gcloud builds triggers run tf-portfolio-app-main --branch=main --project=palladius-genai

# authenticate with Google Cloud
auth:
    gcloud auth application-default login

# Initialize Terraform
terraform-init:
    terraform -chdir=iac init

# Apply Terraform configuration
terraform-apply:
    terraform -chdir=iac apply -var-file=terraform.tfvars -auto-approve


# List latest 10 CB builds, possible the first might still be running
cloud-build-list:
    gcloud builds list --project=palladius-genai --limit=10

# Show the log of a specific Cloud Build, eg 7c82188e-485a-4735-a70d-fb303fbfe5a0
cloud-build-show-log build_id:
    @echo "Showing log for build ID: {{build_id}}. Use --stream to follow the log indefinitely (you can do it, but I want Gemini NOT to do it)."
    gcloud builds log {{build_id}} --project=palladius-genai


# [JOB] Generate screenshots for the portfolio application
generate-screenshots:
    @echo "Generating screenshots..."
    npx tsx scripts/generate-screenshots.ts
