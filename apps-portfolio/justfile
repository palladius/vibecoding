set dotenv-load := true

# Justfile for the portfolio application

# List all available commands
list:
    @just -l

# Run the development server
run:
    npm run dev

# Install dependencies
install:
    npm install

# Run the development server and log output
run-dev:
    mkdir -p log
    npm run dev -- -p 3001 &> log/dev.log

# View the development log
log:
    cat log/dev.log

# Run tests
test:
    npm test

# Import data from YAML to SQLite
import:
    npx tsx scripts/import-yaml.ts

# Build the Docker image
docker-build:
    docker build -t portfolio-app .

# Run the Docker container
docker-run:
    mkdir -p log
    docker run -p 8080:8080 portfolio-app &> log/docker.log &

# Print environment variables                       │
env-print:
    @echo "Project ID: ${GOOGLE_PROJECT_ID}"
    @echo "Region: ${GOOGLE_REGION}"

# Trigger a Cloud Build using the local source
build:
    @echo "Building and deploying to project ${GOOGLE_PROJECT_ID}..."
    @gcloud builds submit --project="${GOOGLE_PROJECT_ID}" --config cloudbuild.yaml .

# Trigger the Cloud Build pipeline from the git repository
trigger-build:
    gcloud builds triggers run tf-portfolio-app-main --branch=main --project=palladius-genai

# authenticate with Google Cloud
auth:
    gcloud auth application-default login

# Initialize Terraform
terraform-init:
    terraform -chdir=iac init

# Apply Terraform configuration
terraform-apply:
    terraform -chdir=iac apply -var-file=terraform.tfvars -auto-approve
