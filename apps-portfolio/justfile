set dotenv-load := true

# TODO: add APP_VERSION=`cat VERSION`

# Justfile for the portfolio application

# List all available commands
list: env-print
    @just -l

# Run the development server
run:
    DATABASE_URL="file:./db/portfolio.sqlite3" npm run dev -- -p 3001

# Install dependencies
install:
    npm install

run-dev:
    @echo "Running development server on port 3001..."
    API_URL=http://localhost:3001 NEXT_PUBLIC_API_URL=http://localhost:3001 npm run dev -- -p 3001 2>&1 | tee log/dev.log
# Run the development server and log output
run-dev-p3002:
    mkdir -p log
    @echo "Running development server on port 3002, maybe because 3001 is busy or unavailable..."
    #@echo "Logging output to log/dev.log"
    @echo "NEXT_PUBLIC_API_URL: $NEXT_PUBLIC_API_URL"
    @echo "DATABASE_URL:        $DATABASE_URL"
    DATABASE_URL="file:./db/portfolio.sqlite3" API_URL=http://localhost:3002 NEXT_PUBLIC_API_URL=http://localhost:3002 npm run dev -- -p 3002 2>&1 | tee log/dev.log

# View the development log
log:
    cat log/dev.log

# [test] Run lint tests
lint:
    # npm run lint # or maybe npx eslint . ?

# Run tests
test:
    @echo "Running tests... Riccardo 2 gemini: note this code tends to execute for >5min so refrain from running it yourself"
    just db-migrate-test
    time npm test

test-estensive: test lint db-show import
    @echo "Running extensive tests... Riccardo 2 gemini: note this code tends to execute for >5min so refrain from running it yourself"
#    time npm test -- --runInBand


# [JOB] Import data from YAML to SQLite. TODO rename to db-import
import:
    DATABASE_URL="file:./db/portfolio.sqlite3" npx tsx scripts/import-yaml.ts

# [JOB] Test import data from YAML to SQLite.
test-import:
    DATABASE_URL="file:$(pwd)/db/portfolio.sqlite3" npx tsx scripts/import-yaml.ts

# [JOB] Migrate test database
db-migrate-test:
    DATABASE_URL="file:$(pwd)/db/portfolio.sqlite3" npx prisma migrate dev

# [JOB] Show database content
db-show:
    npx tsx scripts/show-db.ts

# [DOCKER] Build the Docker image
docker-build:
    time docker build --build-arg DATABASE_URL="file:/app/db/portfolio.sqlite3" -t portfolio-app:v`cat VERSION` .

# [DOCKER] Run the Docker container
docker-run:
    @echo running on port 8081.
    mkdir -p log
    docker run -it -p 8081:8080  -e PORT=8080 portfolio-app:v`cat VERSION`
    # &> log/docker.log

# [DOCKER] Builds the Docker image then runs the container. This is based on VERSION file.
docker-build-and-run:  docker-build docker-run

docker-run-riccardo-test-8081:
    mkdir -p log
    docker run -it -p 8081:8080  -e PORT=8080,NODE_ENV=production,DEBUG='*' portfolio-app:v`cat VERSION` &> log/docker.log

# Print environment variables
env-print:
    @echo "Project ID: ${GOOGLE_PROJECT_ID}"
    @echo "Region: ${GOOGLE_REGION}"

# Trigger a Cloud Build using the local source
build:
    @echo "Building and deploying to project ${GOOGLE_PROJECT_ID}..."
    @gcloud builds submit --project="${GOOGLE_PROJECT_ID}" --config cloudbuild.yaml .

# Trigger the Cloud Build pipeline from the git repository
trigger-build:
    gcloud builds triggers run tf-portfolio-app-main --branch=main --project=palladius-genai

# authenticate with Google Cloud
auth:
    gcloud auth application-default login

# Initialize Terraform
terraform-init:
    terraform -chdir=iac init

# Apply Terraform configuration
terraform-apply:
    terraform -chdir=iac apply -var-file=terraform.tfvars -auto-approve


# List latest 10 CB builds, possible the first might still be running
cloud-build-list:
    gcloud builds list --project=palladius-genai --limit=10

# Show the log of a specific Cloud Build, eg 7c82188e-485a-4735-a70d-fb303fbfe5a0
cloud-build-show-log build_id:
    @echo "Showing log for build ID: {{build_id}}. Use --stream to follow the log indefinitely (you can do it, but I want Gemini NOT to do it)."
    gcloud builds log {{build_id}} --project=palladius-genai


# [JOB] Generate screenshots for the portfolio application
generate-screenshots:
    @echo "Generating screenshots..."
    npx tsx scripts/generate-screenshots.ts

check-port-8080:
     sudo lsof -i :8080
check-port-3001:
     sudo lsof -i :3001
     # kill them all: lsof -t -i:3001 | xargs kill -9


