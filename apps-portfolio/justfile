# Justfile for the portfolio application

# List all available commands
list:
    @just -l

# Run the development server
run:
    npm run dev

# Install dependencies
install:
    npm install

# Run the development server and log output
run-dev:
    mkdir -p log
    npm run dev -- -p 3001 &> log/dev.log

# View the development log
log:
    cat log/dev.log

# Run tests
test:
    npm test

# Import data from YAML to SQLite
import:
    npx tsx scripts/import-yaml.ts

# Build the Docker image
docker-build:
    docker build -t portfolio-app .

# Run the Docker container
docker-run:
    mkdir -p log
    docker run -p 8080:8080 portfolio-app &> log/docker.log &

# Trigger the Cloud Build pipeline
cloud-build:
    @export $(cat .env | grep -v '^#' | xargs) && gcloud builds submit --project=$GOOGLE_PROJECT_ID --config cloudbuild.yaml --substitutions=_PROJECT_ID=$GOOGLE_PROJECT_ID,_TAG=v$(cat VERSION) .

# Find processes on ports 3001 and 8080
ps:
    @netstat -anp | grep LISTEN | egrep '3001|8080' || echo "No processes found listening on ports 3001 or 8080"
    @# Alternative:     @lsof -iTCP:3001,8080 -sTCP:LISTEN || echo "No processes found listening on ports 3001 or 8080"

# Curl the Cloud Run service as ricc@google.com
curl-cloudrun-as-riccardo:
    @URL=$(gcloud run services describe portfolio-app --platform=managed --region=europe-west1 --project=ricc-genai --format='value(status.url)'); \
    echo "Riccardo, I will now curl $URL for you, great success!"; \
    curl -H "Authorization: Bearer $(gcloud auth print-identity-token --impersonate-service-account=portfolio-invoker@ricc-genai.iam.gserviceaccount.com --audiences=$URL --include-email)" $URL
