# VibeCheck Justfile

# Default task to run the checks
default: list

# Set the shell to bash for all recipes
set shell := ["bash", "-c"]

# --- Development Tasks ---

# List available commands
list:
    @just -l

# Setup the virtual environment and install dependencies
setup:
    @echo "Setting up virtual environment for VibeCheck..."
    uv venv
    uv sync
    @echo "✅ Done!"

# Run the main application concisely
run:
    @echo "🚀 Running VibeCheck (concise)..."
    uv run python src/main.py

# Run the main application with verbose output
run-verbose:
    @echo "🚀 Running VibeCheck (verbose)..."
    uv run python src/main.py --verbose

# --- Utility Tasks ---

# Clean up temporary files
clean:
    @echo "Cleaning up..."
    find . -type f -name '*.pyc' -delete
    find . -type d -name '__pycache__' -delete
