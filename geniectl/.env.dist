# To use the Gemini API via Vertex AI, set the following environment variables.
# The library will use Application Default Credentials (ADC) for authentication.

# Your Google Cloud project ID
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# Set to true to use Vertex AI backend
GOOGLE_GENAI_USE_VERTEXAI="true"

# The URL for the local MCP audio generation server
MCP_AUDIO_SERVER_URL="http://localhost:8080/generate_audio"
