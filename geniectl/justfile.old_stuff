
# old but potentially useful stuff for the future

# --- GCP Setup ---

gcp-create-service-account:
    bin/gcp-setup.sh create-service-account

gcp-grant-iam-to-service-account:
    bin/gcp-setup.sh grant-iam-to-service-account

gcp-create-service-account-key:
    bin/gcp-setup.sh create-service-account-key

gcp-revoke-iam:
    bin/gcp-setup.sh revoke-iam

gcp-grant-iam:
    bin/gcp-setup.sh grant-iam
